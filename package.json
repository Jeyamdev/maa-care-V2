{
  "name": "maa-care",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @maa-care/mobile",
    "android": "npm run android -w @maa-care/mobile",
    "ios": "npm run ios -w @maa-care/mobile",
    "dev:web": "npm run dev -w @maa-care/web",
    "build:web": "npm run build -w @maa-care/web",
    "preview:web": "npm run preview -w @maa-care/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/verify-screening.cjs && npm run test -w @maa-care/epds-core",
    "test:web": "npm run test -w @maa-care/web",
    "export:android": "npm run export:android -w @maa-care/mobile"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
